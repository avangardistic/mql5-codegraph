{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mql5-codegraph.local/contracts/intelligence-v1.schema.json",
  "title": "MQL5 CodeGraph Intelligence Contract v1",
  "oneOf": [
    { "$ref": "#/$defs/request" },
    { "$ref": "#/$defs/result" },
    { "$ref": "#/$defs/errorEnvelope" }
  ],
  "$defs": {
    "bounds": {
      "type": "object",
      "additionalProperties": false,
      "required": ["max_depth", "max_items", "max_paths", "max_expansions", "context_units"],
      "properties": {
        "max_depth": { "type": "integer", "minimum": 0, "maximum": 5 },
        "max_items": { "type": "integer", "minimum": 1, "maximum": 2000 },
        "max_paths": { "type": "integer", "minimum": 1, "maximum": 20 },
        "max_expansions": { "type": "integer", "minimum": 1, "maximum": 100000 },
        "context_units": { "type": "integer", "minimum": 1, "maximum": 10000 }
      }
    },
    "selector": {
      "type": "object",
      "additionalProperties": false,
      "required": ["value", "kind"],
      "properties": {
        "value": { "type": "string", "minLength": 1 },
        "kind": { "type": ["string", "null"] }
      }
    },
    "candidate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["node_id", "match_rank"],
      "properties": {
        "node_id": { "type": "string" },
        "match_rank": { "type": "integer", "minimum": 0, "maximum": 3 }
      }
    },
    "resolution": {
      "type": "object",
      "additionalProperties": false,
      "required": ["selector", "status", "candidates", "omitted_candidates"],
      "properties": {
        "selector": { "$ref": "#/$defs/selector" },
        "status": { "enum": ["matched", "ambiguous", "no_match"] },
        "candidates": { "type": "array", "items": { "$ref": "#/$defs/candidate" } },
        "omitted_candidates": { "type": ["integer", "null"], "minimum": 0 }
      }
    },
    "request": {
      "type": "object",
      "additionalProperties": false,
      "required": ["contract_version", "operation", "targets", "direction", "relationship_types", "node_kinds", "bounds", "expected_source_fingerprint", "client_request_id"],
      "properties": {
        "contract_version": { "type": "string", "pattern": "^1\\.[0-9]+\\.[0-9]+$" },
        "operation": { "enum": ["query", "context", "impact", "diagnostics", "path", "context_package"] },
        "targets": { "type": "array", "items": { "$ref": "#/$defs/selector" }, "maxItems": 2 },
        "direction": { "enum": ["incoming", "outgoing", "both"] },
        "relationship_types": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
        "node_kinds": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
        "bounds": { "$ref": "#/$defs/bounds" },
        "expected_source_fingerprint": { "type": ["string", "null"] },
        "client_request_id": { "type": ["string", "null"] }
      }
    },
    "graphIdentity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["graph_schema_version", "source_fingerprint", "snapshot_revision"],
      "properties": {
        "graph_schema_version": { "type": "string" },
        "source_fingerprint": { "type": ["string", "null"] },
        "snapshot_revision": { "type": ["integer", "null"], "minimum": 0 }
      }
    },
    "location": {
      "type": ["object", "null"],
      "required": ["file", "line", "column"],
      "properties": {
        "file": { "type": "string" },
        "line": { "type": "integer", "minimum": 1 },
        "column": { "type": "integer", "minimum": 1 },
        "end_line": { "type": "integer", "minimum": 1 },
        "end_column": { "type": "integer", "minimum": 1 }
      }
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["subject_id", "origin", "confidence", "location", "state", "state_reason"],
      "properties": {
        "subject_id": { "type": "string" },
        "origin": { "enum": ["extracted", "resolved", "runtime", "inferred"] },
        "confidence": { "type": "number", "minimum": 0.0, "maximum": 1.0 },
        "location": { "$ref": "#/$defs/location" },
        "state": { "enum": ["available", "stale", "unavailable", "unknown", "not_applicable"] },
        "state_reason": { "type": ["string", "null"] }
      }
    },
    "nodeSummary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "kind", "name", "qualified_name", "location", "attributes"],
      "properties": {
        "id": { "type": "string" },
        "kind": { "type": "string" },
        "name": { "type": "string" },
        "qualified_name": { "type": "string" },
        "location": { "$ref": "#/$defs/location" },
        "attributes": { "type": "object" }
      }
    },
    "relationship": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "source", "target", "relationship", "evidence"],
      "properties": {
        "id": { "type": "string" },
        "source": { "type": "string" },
        "target": { "type": "string" },
        "relationship": { "type": "string" },
        "evidence": { "$ref": "#/$defs/evidence" }
      }
    },
    "pathHop": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source_id", "target_id", "edge_id", "relationship", "direction", "evidence"],
      "properties": {
        "source_id": { "type": "string" },
        "target_id": { "type": "string" },
        "edge_id": { "type": "string" },
        "relationship": { "type": "string" },
        "direction": { "enum": ["forward", "reverse"] },
        "evidence": { "$ref": "#/$defs/evidence" }
      }
    },
    "directedPath": {
      "type": "object",
      "additionalProperties": false,
      "required": ["rank", "node_ids", "hops", "ranking_policy"],
      "properties": {
        "rank": { "type": "integer", "minimum": 1 },
        "node_ids": { "type": "array", "minItems": 1, "items": { "type": "string" } },
        "hops": { "type": "array", "items": { "$ref": "#/$defs/pathHop" } },
        "ranking_policy": { "const": "evidence_first_v1" }
      }
    },
    "contextItem": {
      "type": "object",
      "additionalProperties": false,
      "required": ["rank", "category", "distance", "cost_units", "subject_id", "summary", "evidence"],
      "properties": {
        "rank": { "type": "integer", "minimum": 1 },
        "category": { "enum": ["target", "ambiguity", "node", "relationship", "diagnostic"] },
        "distance": { "type": "integer", "minimum": 0 },
        "cost_units": { "const": 1 },
        "subject_id": { "type": "string" },
        "summary": { "type": "object" },
        "evidence": { "oneOf": [{ "$ref": "#/$defs/evidence" }, { "type": "null" }] }
      }
    },
    "omission": {
      "type": "object",
      "additionalProperties": false,
      "required": ["category", "count"],
      "properties": {
        "category": { "type": "string" },
        "count": { "type": ["integer", "null"], "minimum": 0 }
      }
    },
    "contextPackage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["budget_kind", "budget_limit", "budget_used", "items", "omissions"],
      "properties": {
        "budget_kind": { "const": "structural_record_v1" },
        "budget_limit": { "type": "integer", "minimum": 1, "maximum": 10000 },
        "budget_used": { "type": "integer", "minimum": 0, "maximum": 10000 },
        "items": { "type": "array", "items": { "$ref": "#/$defs/contextItem" } },
        "omissions": { "type": "array", "items": { "$ref": "#/$defs/omission" } }
      }
    },
    "diagnostic": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "severity", "code", "message", "evidence"],
      "properties": {
        "id": { "type": "string" },
        "severity": { "enum": ["error", "warning", "info"] },
        "code": { "type": "string" },
        "message": { "type": "string" },
        "evidence": { "$ref": "#/$defs/evidence" }
      }
    },
    "completion": {
      "type": "object",
      "additionalProperties": false,
      "required": ["search_complete", "truncated", "reason", "omitted_counts", "explored_nodes", "explored_edges"],
      "properties": {
        "search_complete": { "type": "boolean" },
        "truncated": { "type": "boolean" },
        "reason": { "enum": ["complete", "no_match", "not_connected", "max_depth", "max_items", "max_paths", "max_expansions", "context_budget"] },
        "omitted_counts": { "type": "object", "additionalProperties": { "type": ["integer", "null"], "minimum": 0 } },
        "explored_nodes": { "type": "integer", "minimum": 0 },
        "explored_edges": { "type": "integer", "minimum": 0 }
      }
    },
    "result": {
      "type": "object",
      "additionalProperties": false,
      "required": ["contract_version", "operation", "graph_identity", "request", "resolution", "nodes", "relationships", "paths", "context_package", "diagnostics", "limits_applied", "completion"],
      "properties": {
        "contract_version": { "const": "1.0.0" },
        "operation": { "enum": ["query", "context", "impact", "diagnostics", "path", "context_package"] },
        "graph_identity": { "$ref": "#/$defs/graphIdentity" },
        "request": { "$ref": "#/$defs/request" },
        "resolution": { "type": "array", "items": { "$ref": "#/$defs/resolution" } },
        "nodes": { "type": "array", "items": { "$ref": "#/$defs/nodeSummary" } },
        "relationships": { "type": "array", "items": { "$ref": "#/$defs/relationship" } },
        "paths": { "type": "array", "items": { "$ref": "#/$defs/directedPath" } },
        "context_package": { "oneOf": [{ "$ref": "#/$defs/contextPackage" }, { "type": "null" }] },
        "diagnostics": { "type": "array", "items": { "$ref": "#/$defs/diagnostic" } },
        "limits_applied": { "$ref": "#/$defs/bounds" },
        "completion": { "$ref": "#/$defs/completion" }
      }
    },
    "errorEnvelope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["error"],
      "properties": {
        "error": {
          "type": "object",
          "additionalProperties": false,
          "required": ["contract_version", "category", "code", "message", "field", "retryable"],
          "properties": {
            "contract_version": { "type": "string" },
            "category": { "enum": ["request", "compatibility", "state", "integrity", "internal"] },
            "code": { "enum": ["invalid_request", "invalid_parameter", "missing_target", "unsupported_operation", "unsupported_contract_version", "unsupported_graph_schema", "graph_not_ready", "graph_identity_mismatch", "graph_integrity_error", "internal_error"] },
            "message": { "type": "string" },
            "field": { "type": ["string", "null"] },
            "retryable": { "type": "boolean" }
          }
        }
      }
    }
  }
}
